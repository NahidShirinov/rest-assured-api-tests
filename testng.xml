<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="API Tests" verbose="1">
    <!-- Framework-ün öz testləri: API lazım deyil, saniyələr çəkir -->
    <test name="Framework unit tests">
        <classes>
            <class name="az.apitest.unit.MatcherFactoryTest"/>
            <class name="az.apitest.unit.PlaceholdersTest"/>
            <class name="az.apitest.unit.DependencyChainTest"/>
            <class name="az.apitest.unit.TestFilesValidTest"/>
        </classes>
    </test>
    <test name="JSON-driven">
        <classes>
            <class name="az.apitest.tests.datadriven.JsonDrivenApiTest"/>
        </classes>
    </test>
    <!-- Kodla yazdığın testləri bura əlavə et:
    <test name="Code-based">
        <classes>
            <class name="az.apitest.tests.code.MyApiTest"/>
        </classes>
    </test>
    -->
</suite>
