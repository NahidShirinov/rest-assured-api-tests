{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StatsResponse (GET /api/stats)",
  "type": "object",
  "required": [
    "successCount",
    "failureCount",
    "total",
    "successRatePercent"
  ],
  "properties": {
    "successCount": {
      "type": "integer",
      "minimum": 0
    },
    "failureCount": {
      "type": "integer",
      "minimum": 0
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "successRatePercent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    }
  }
}
