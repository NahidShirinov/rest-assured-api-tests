{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Page<CardStatusRecord> (GET /api/cards?page=&size=&sort=)",
  "type": "object",
  "required": ["content", "totalElements", "totalPages", "size", "number"],
  "properties": {
    "content": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["recordId", "id", "cardNumber", "requestedStatus", "result", "processedAt"],
        "properties": {
          "recordId": { "type": "integer" },
          "id": { "type": "string" },
          "cardNumber": { "type": "string" },
          "requestedStatus": { "type": "string" },
          "result": { "type": "string", "enum": ["SUCCESS", "FAILURE"] },
          "processedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" }
        }
      }
    },
    "totalElements": { "type": "integer", "minimum": 0 },
    "totalPages": { "type": "integer", "minimum": 0 },
    "size": { "type": "integer", "minimum": 1 },
    "number": { "type": "integer", "minimum": 0 }
  }
}
