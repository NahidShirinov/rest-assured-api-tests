{
  "$schema": "../api-test.schema.json",
  "suite": "Card Status API",
  "variables": {
    "statusPath": "/api/cards/status",
    "cardsPath": "/api/cards",
    "batchPath": "/api/cards/status/batch",
    "resultSchema": "schemas/card-status/processing-result.json",
    "pageSchema": "schemas/card-status/card-status-record-page.json",
    "latestPageSize": 100,
    "negativeCardNumber": "4111${random.digits:12}",
    "okId": "${random.uuid}-1",
    "failId": "${random.uuid}-5",
    "idemId": "${random.uuid}-1",
    "idemKey": "${random.uuid}",
    "cardNumber": "4111${random.digits:12}",
    "batchId": "batch-${random.string}"
  },
  "tests": [
    {
      "name": "Kart statusunu dəyiş: xarici servis uğurlu",
      "description": "WireMock: id 0 və ya 5 ilə bitmirsə xarici servis uğur qaytarır. DB: qeyd + outbox hadisəsi yazılır, outbox Kafka-ya göndərilir (SENT), consumer success_card-a yazır",
      "tags": ["smoke"],
      "method": "POST",
      "path": "${statusPath}",
      "bodyFile": "testdata/_files/card-status-request.json",
      "bodyOverrides": { "id": "${okId}", "cardNumber": "${cardNumber}", "requestedStatus": "BLOCKED" },
      "expect": {
        "status": 200,
        "maxTimeMs": 5000,
        "schema": "${resultSchema}",
        "body": {
          "id": "${okId}",
          "cardNumber": "${cardNumber}",
          "success": true,
          "errorMessage": null,
          "totalMs": "gte:0"
        }
      },
      "extract": { "processedId": "id" },
      "db": [
        {
          "query": "SELECT card_number, requested_status, result FROM card_status_record WHERE id = ?",
          "params": ["${okId}"],
          "expect": {
            "size()": 1,
            "[0].card_number": "${cardNumber}",
            "[0].requested_status": "BLOCKED",
            "[0].result": "SUCCESS"
          }
        },
        {
          "query": "SELECT status, attempts, payload FROM outbox_event WHERE card_id = ?",
          "params": ["${okId}"],
          "expect": {
            "size()": 1,
            "[0].status": "SENT",
            "[0].payload": "contains:\"result\":\"SUCCESS\""
          },
          "await": { "timeoutMs": 15000, "intervalMs": 300 }
        },
        {
          "query": "SELECT card_number, status, result FROM success_card WHERE card_id = ?",
          "params": ["${okId}"],
          "expect": { "size()": 1, "[0].card_number": "${cardNumber}", "[0].status": "BLOCKED" },
          "await": { "timeoutMs": 15000, "intervalMs": 300 }
        }
      ]
    },
    {
      "name": "Kart statusunu dəyiş: xarici servis 500 qaytarır",
      "description": "WireMock: id 5 ilə bitəndə xarici servis 500 qaytarır. API yenə 200 qaytarır, amma success=false; hadisə failure_card-a düşür, success_card-a yox",
      "method": "POST",
      "path": "${statusPath}",
      "bodyFile": "testdata/_files/card-status-request.json",
      "bodyOverrides": { "id": "${failId}", "requestedStatus": "BLOCKED" },
      "expect": {
        "status": 200,
        "schema": "${resultSchema}",
        "body": {
          "id": "${failId}",
          "success": false,
          "errorMessage": "contains:500"
        }
      },
      "db": [
        {
          "query": "SELECT result FROM card_status_record WHERE id = ?",
          "params": ["${failId}"],
          "expect": { "size()": 1, "[0].result": "FAILURE" }
        },
        {
          "query": "SELECT status, result FROM failure_card WHERE card_id = ?",
          "params": ["${failId}"],
          "expect": { "size()": 1, "[0].result": "FAILURE" },
          "await": { "timeoutMs": 15000, "intervalMs": 300 }
        },
        {
          "query": "SELECT 1 FROM success_card WHERE card_id = ?",
          "params": ["${failId}"],
          "expect": { "size()": 0 }
        }
      ]
    },
    {
      "name": "Emal olunan yazı API-də görünür",
      "description": "Ən yeni 100 qeyd arasında əvvəlki testin id-si ilə axtarır",
      "tags": ["smoke"],
      "method": "GET",
      "path": "${cardsPath}",
      "queryParams": { "size": "${latestPageSize}", "sort": "recordId,desc" },
      "expect": {
        "status": 200,
        "schema": "${pageSchema}",
        "body": {
          "content.findAll { it.id == '${processedId}' }.size()": 1,
          "content.find { it.id == '${processedId}' }.cardNumber": "${cardNumber}",
          "content.find { it.id == '${processedId}' }.requestedStatus": "BLOCKED",
          "content.find { it.id == '${processedId}' }.result": "SUCCESS",
          "content.find { it.id == '${failId}' }.result": "FAILURE"
        }
      }
    },
    {
      "name": "Səhifələmə: size=${size}",
      "description": "dataSets: eyni test bir neçə səhifə ölçüsü ilə",
      "method": "GET",
      "path": "${cardsPath}",
      "queryParams": { "page": 0, "size": "${size}" },
      "dataSets": [
        { "size": 1 },
        { "size": 2 },
        { "size": 5 }
      ],
      "expect": {
        "status": 200,
        "schema": "${pageSchema}",
        "body": {
          "size": "${size}",
          "number": 0,
          "content.size()": "${size}",
          "totalElements": "gte:${size}"
        }
      }
    },
    {
      "name": "Idempotency-Key: ilk sorğu",
      "method": "POST",
      "path": "${statusPath}",
      "headers": { "Idempotency-Key": "${idemKey}" },
      "bodyFile": "testdata/_files/card-status-request.json",
      "bodyOverrides": { "id": "${idemId}" },
      "expect": { "status": 200, "body": { "id": "${idemId}", "success": true } },
      "extract": { "idemTotalMs": "totalMs", "idemCardNumber": "cardNumber" }
    },
    {
      "name": "Idempotency-Key: təkrar sorğu eyni nəticəni qaytarır",
      "description": "Yenidən emal olunsaydı totalMs demək olar ki, həmişə fərqli olardı",
      "method": "POST",
      "path": "${statusPath}",
      "headers": { "Idempotency-Key": "${idemKey}" },
      "bodyFile": "testdata/_files/card-status-request.json",
      "bodyOverrides": { "id": "${idemId}", "cardNumber": "${idemCardNumber}" },
      "expect": {
        "status": 200,
        "body": { "id": "${idemId}", "totalMs": "${idemTotalMs}", "cardNumber": "${idemCardNumber}" }
      }
    },
    {
      "name": "Idempotency-Key: API-də və DB-də yalnız 1 qeyd var",
      "method": "GET",
      "path": "${cardsPath}",
      "queryParams": { "size": "${latestPageSize}", "sort": "recordId,desc" },
      "expect": {
        "status": 200,
        "body": { "content.findAll { it.id == '${idemId}' }.size()": 1 }
      },
      "db": [
        {
          "query": "SELECT count(*) AS cnt FROM card_status_record WHERE id = ?",
          "params": ["${idemId}"],
          "expect": { "[0].cnt": 1 }
        },
        {
          "query": "SELECT response_body FROM idempotency_record WHERE idempotency_key = ?",
          "params": ["${idemKey}"],
          "expect": { "size()": 1, "[0].response_body": "contains:${idemId}" }
        }
      ]
    },
    {
      "name": "Batch: hər element emal olunur və sıra qorunur",
      "method": "POST",
      "path": "${batchPath}",
      "body": [
        { "id": "${batchId}-1", "cardNumber": "4111${random.digits:12}", "requestedStatus": "ACTIVE" },
        { "id": "${batchId}-2", "cardNumber": "4111${random.digits:12}", "requestedStatus": "BLOCKED" },
        { "id": "${batchId}-5", "cardNumber": "4111${random.digits:12}", "requestedStatus": "EXPIRED" }
      ],
      "expect": {
        "status": 200,
        "maxTimeMs": 10000,
        "schema": "schemas/card-status/processing-result-list.json",
        "body": {
          "size()": 3,
          "id": ["${batchId}-1", "${batchId}-2", "${batchId}-5"],
          "success": [true, true, false]
        }
      },
      "db": [
        {
          "query": "SELECT id, result FROM card_status_record WHERE id LIKE ? ORDER BY id",
          "params": ["${batchId}-%"],
          "expect": {
            "id": ["${batchId}-1", "${batchId}-2", "${batchId}-5"],
            "result": ["SUCCESS", "SUCCESS", "FAILURE"]
          }
        },
        {
          "query": "SELECT card_id FROM success_card WHERE card_id LIKE ? ORDER BY card_id",
          "params": ["${batchId}-%"],
          "expect": { "card_id": ["${batchId}-1", "${batchId}-2"] },
          "await": { "timeoutMs": 15000, "intervalMs": 300 }
        },
        {
          "query": "SELECT card_id FROM failure_card WHERE card_id LIKE ?",
          "params": ["${batchId}-%"],
          "expect": { "card_id": ["${batchId}-5"] },
          "await": { "timeoutMs": 15000, "intervalMs": 300 }
        }
      ]
    },
    {
      "name": "Boş batch -> boş cavab",
      "method": "POST",
      "path": "${batchPath}",
      "body": [],
      "expect": { "status": 200, "body": { "size()": 0 } }
    },
    {
      "name": "Stats: total = success + failure",
      "tags": ["smoke"],
      "method": "GET",
      "path": "/api/stats",
      "expect": {
        "status": 200,
        "schema": "schemas/card-status/stats.json",
        "body": {
          "with { successCount + failureCount == total }": true,
          "with { successRatePercent >= 0 && successRatePercent <= 100 }": true
        }
      }
    },
    {
      "name": "Məcburi sahələr olmadan -> 400",
      "tags": ["negative"],
      "method": "POST",
      "path": "${statusPath}",
      "body": {},
      "expect": {
        "status": 400,
        "body": {
          "error": "Validation failed",
          "details.size()": 3,
          "details.any { it.startsWith('id:') }": true,
          "details.any { it.startsWith('cardNumber:') }": true,
          "details.any { it.startsWith('requestedStatus:') }": true
        }
      }
    },
    {
      "name": "Validasiya: ${case} -> 400",
      "description": "dataFile: hər CSV sətri bir sahəni boş mətn və ya null edir",
      "tags": ["negative"],
      "method": "POST",
      "path": "${statusPath}",
      "dataFile": "testdata/_files/card-validation.csv",
      "body": { "id": "${id}", "cardNumber": "${cardNumber}", "requestedStatus": "${requestedStatus}" },
      "expect": {
        "status": 400,
        "body": { "error": "Validation failed", "details": ["${field}: ${field} must not be blank"] }
      }
    },
    {
      "name": "requestedStatus sahəsi olmadan -> 400",
      "description": "bodyRemove: body faylından sahəni silir",
      "tags": ["negative"],
      "method": "POST",
      "path": "${statusPath}",
      "bodyFile": "testdata/_files/card-status-request.json",
      "bodyRemove": ["requestedStatus"],
      "expect": {
        "status": 400,
        "body": { "details": ["requestedStatus: requestedStatus must not be blank"] }
      }
    },
    {
      "name": "Batch-da səhv element -> 400",
      "tags": ["negative"],
      "method": "POST",
      "path": "${batchPath}",
      "body": [
        { "id": "${batchId}-ok-1", "cardNumber": "${negativeCardNumber}", "requestedStatus": "ACTIVE" },
        { "id": "", "cardNumber": "${negativeCardNumber}", "requestedStatus": "ACTIVE" }
      ],
      "expect": { "status": 400 }
    },
    {
      "name": "Body obyekt deyil -> 400",
      "tags": ["negative"],
      "method": "POST",
      "path": "${statusPath}",
      "body": "not-an-object",
      "expect": { "status": 400, "body": { "error": "Bad Request" } }
    },
    {
      "name": "GET status endpoint-i dəstəkləmir -> 405",
      "tags": ["negative"],
      "method": "GET",
      "path": "${statusPath}",
      "expect": { "status": 405 }
    }
  ]
}
