{
  "$schema": "../api-test.schema.json",
  "suite": "Card Status API",
  "variables": {
    "requestId": "${random.uuid}",
    "cardNumber": "4111${random.digits:12}",
    "batchId": "batch-${random.string}"
  },
  "tests": [
    {
      "name": "Tək kart statusunu dəyiş",
      "description": "Xarici servis mock-u ~20% təsadüfi xəta qaytarır, ona görə success true/false ola bilər",
      "tags": ["smoke"],
      "method": "POST",
      "path": "/api/cards/status",
      "body": {
        "id": "${requestId}",
        "cardNumber": "${cardNumber}",
        "requestedStatus": "BLOCKED"
      },
      "expect": {
        "status": 200,
        "maxTimeMs": 5000,
        "schema": "schemas/card-status/processing-result.json",
        "body": {
          "id": "${requestId}",
          "cardNumber": "${cardNumber}",
          "success": "type:boolean",
          "totalMs": "gte:0"
        }
      },
      "extract": { "processedId": "id" }
    },
    {
      "name": "Emal olunan yazı DB-də görünür",
      "description": "Ən yeni 100 qeyd arasında əvvəlki testin id-si ilə axtarır",
      "tags": ["smoke"],
      "method": "GET",
      "path": "/api/cards",
      "queryParams": { "size": 100, "sort": "recordId,desc" },
      "expect": {
        "status": 200,
        "schema": "schemas/card-status/card-status-record-page.json",
        "body": {
          "content.findAll { it.id == '${processedId}' }.size()": 1,
          "content.find { it.id == '${processedId}' }.cardNumber": "${cardNumber}",
          "content.find { it.id == '${processedId}' }.requestedStatus": "BLOCKED",
          "content.find { it.id == '${processedId}' }.result": "oneOf:SUCCESS|FAILURE"
        }
      }
    },
    {
      "name": "Səhifələmə: size parametri işləyir",
      "method": "GET",
      "path": "/api/cards",
      "queryParams": { "page": 0, "size": 2 },
      "expect": {
        "status": 200,
        "schema": "schemas/card-status/card-status-record-page.json",
        "body": {
          "size": 2,
          "number": 0,
          "content.size()": 2,
          "totalElements": "gte:2"
        }
      }
    },
    {
      "name": "Batch: hər element emal olunur və sıra qorunur",
      "method": "POST",
      "path": "/api/cards/status/batch",
      "body": [
        { "id": "${batchId}-1", "cardNumber": "4111${random.digits:12}", "requestedStatus": "ACTIVE" },
        { "id": "${batchId}-2", "cardNumber": "4111${random.digits:12}", "requestedStatus": "BLOCKED" },
        { "id": "${batchId}-3", "cardNumber": "4111${random.digits:12}", "requestedStatus": "EXPIRED" }
      ],
      "expect": {
        "status": 200,
        "maxTimeMs": 10000,
        "schema": "schemas/card-status/processing-result-list.json",
        "body": {
          "size()": 3,
          "id": ["${batchId}-1", "${batchId}-2", "${batchId}-3"]
        }
      }
    },
    {
      "name": "Boş batch -> boş cavab",
      "method": "POST",
      "path": "/api/cards/status/batch",
      "body": [],
      "expect": { "status": 200, "body": { "size()": 0 } }
    },
    {
      "name": "Stats: total = success + failure",
      "tags": ["smoke"],
      "method": "GET",
      "path": "/api/stats",
      "expect": {
        "status": 200,
        "schema": "schemas/card-status/stats.json",
        "body": {
          "with { successCount + failureCount == total }": true,
          "with { successRatePercent >= 0 && successRatePercent <= 100 }": true
        }
      }
    },
    {
      "name": "Məcburi sahələr olmadan -> 400",
      "tags": ["negative"],
      "method": "POST",
      "path": "/api/cards/status",
      "body": {},
      "expect": {
        "status": 400,
        "body": {
          "error": "Validation failed",
          "details.size()": 3,
          "details.any { it.startsWith('id:') }": true,
          "details.any { it.startsWith('cardNumber:') }": true,
          "details.any { it.startsWith('requestedStatus:') }": true
        }
      }
    },
    {
      "name": "Boş sahə -> 400",
      "tags": ["negative"],
      "method": "POST",
      "path": "/api/cards/status",
      "body": { "id": "x-1", "cardNumber": "", "requestedStatus": "ACTIVE" },
      "expect": {
        "status": 400,
        "body": { "details": ["cardNumber: cardNumber must not be blank"] }
      }
    },
    {
      "name": "Batch-da səhv element -> 400",
      "tags": ["negative"],
      "method": "POST",
      "path": "/api/cards/status/batch",
      "body": [
        { "id": "${batchId}-ok-1", "cardNumber": "4111${random.digits:12}", "requestedStatus": "ACTIVE" },
        { "id": "", "cardNumber": "4111${random.digits:12}", "requestedStatus": "ACTIVE" }
      ],
      "expect": { "status": 400 }
    },
    {
      "name": "Body obyekt deyil -> 400",
      "tags": ["negative"],
      "method": "POST",
      "path": "/api/cards/status",
      "body": "not-an-object",
      "expect": { "status": 400, "body": { "error": "Bad Request" } }
    },
    {
      "name": "GET status endpoint-i dəstəkləmir -> 405",
      "tags": ["negative"],
      "method": "GET",
      "path": "/api/cards/status",
      "expect": { "status": 405 }
    }
  ]
}
