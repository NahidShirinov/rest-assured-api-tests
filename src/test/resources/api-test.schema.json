{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "api-test.schema.json",
  "title": "API test suite",
  "description": "testdata/*.json faylları üçün format. Faylın əvvəlinə \"$schema\": \"../api-test.schema.json\" yaz - IntelliJ / VS Code avtomatik tamamlama və səhv göstərəcək.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tests"],
  "properties": {
    "$schema": { "type": "string" },
    "suite": { "type": "string", "description": "Suite adı (hesabatda görünür)" },
    "baseUrl": { "type": "string", "description": "Bu suite üçün base URL. Yoxdursa config-dəki base.url" },
    "headers": { "$ref": "#/definitions/stringMap", "description": "Suite-dəki bütün sorğulara əlavə olunan header-lər" },
    "variables": { "type": "object", "description": "Başlanğıc dəyişənlər: ${ad} ilə istifadə olunur" },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/testCase" }
    }
  },
  "definitions": {
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "paramMap": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "testCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "enabled": { "type": "boolean", "default": true },
        "tags": { "type": "array", "items": { "type": "string" }, "description": "-Dtags=smoke ilə filtr" },
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"],
          "default": "GET"
        },
        "path": { "type": "string", "description": "Məs. /api/users/{id} - {id} pathParams-dan gəlir" },
        "headers": { "$ref": "#/definitions/stringMap" },
        "queryParams": { "$ref": "#/definitions/paramMap" },
        "pathParams": { "$ref": "#/definitions/paramMap" },
        "formParams": { "$ref": "#/definitions/paramMap" },
        "body": { "description": "Request body (istənilən JSON)" },
        "expect": { "$ref": "#/definitions/expectation" },
        "extract": {
          "$ref": "#/definitions/stringMap",
          "description": "{\"ad\": \"json.path\"} və ya {\"ad\": \"header:Location\"} və ya {\"ad\": \"status\"}"
        }
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "maxTimeMs": { "type": "integer", "minimum": 1 },
        "schema": { "type": "string", "description": "classpath-da JSON schema, məs. schemas/user.json" },
        "headers": { "$ref": "#/definitions/stringMap" },
        "body": {
          "type": "object",
          "description": "Açar = GPath (id, items[0].name, size(), find { it.id == 'x' }.name). Dəyər = gözlənən dəyər və ya matcher: notNull, isNull, notEmpty, contains:x, startsWith:x, endsWith:x, regex:..., gt:5, gte:5, lt:5, lte:5, size:3, type:string, oneOf:a|b, not:x"
        }
      }
    }
  }
}
